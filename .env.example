PORT=3001
NODE_ENV=development

# Required by docker-compose.dev.yml; use long, unique local values.
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Origem pública do frontend. Separe múltiplas origens em ALLOWED_ORIGINS.
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
PUBLIC_BACKEND_URL=http://localhost:3001

# Dados persistentes. Paths relativos são resolvidos pela raiz do projeto.
DATA_DIR=storage
LOCAL_LIBRARY_DIR=storage/pdfs
COVER_CACHE_DIR=storage/cache/covers
DRIVE_FOLDERS_CONFIG=storage/drive-folders.json
MANUAL_CATEGORIAS_PATH=storage/categorias.json
LOCAL_FILES_ROUTE=/arquivos

ENABLE_GOOGLE_DRIVE=true
GOOGLE_API_KEY=
GOOGLE_BOOKS_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/callback
DRIVE_FOLDER_ID=
DRIVE_REQUEST_TIMEOUT=15000
DRIVE_CONCURRENCY=6

METADATA_REQUEST_TIMEOUT=10000
METADATA_ENRICH_CONCURRENCY=3
METADATA_MAX_RETRIES=3
METADATA_REVIEW_THRESHOLD=0.65
METADATA_AUTO_APPLY_THRESHOLD=0.85
METADATA_PDF_PAGES=5
METADATA_API_CACHE_DAYS=60
METADATA_NEGATIVE_CACHE_DAYS=3
OPENLIBRARY_API_URL=https://openlibrary.org/api/books
ENRICH_ON_ACCESS=true
CACHE_METADATA=true
REFRESH_METADATA_DAYS=30

COVER_RENDER_CONCURRENCY=2
COVER_WIDTH=500
COVER_MAX_IN_MEMORY_MB=128
COVER_MAX_SOURCE_IMAGE_MB=100
COVER_RENDER_TIMEOUT=30000
COVER_PIPELINE_VERSION=2
READER_MAX_IN_MEMORY_MB=128
CACHE_MAX_GB=2
CACHE_TTL=3600

# Storage provider: local remains the default; R2 is optional and private by default.
STORAGE_PROVIDER=local
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_REGION=auto
R2_PUBLIC_URL=
R2_SIGNED_URL_TTL=300
R2_PREFIX=

USE_FALLBACK_CATEGORIA=Outros
LIBRARY_WATCH_ENABLED=true
LIBRARY_WATCH_DEBOUNCE_MS=1200
JOBS_ENABLED=true
ARARU_PROCESS_JOBS=true
JOB_LEASE_MS=300000
CATALOG_REFRESH_INTERVAL_MINUTES=60
MAINTENANCE_INTERVAL_MINUTES=1440
CATALOG_MISSING_RETENTION_DAYS=30

TRUST_PROXY=false
# Rate limit é opt-in. O nome histórico de API_RATE_LIMIT_PER_MINUTE representa
# o máximo de requisições dentro de RATE_LIMIT_WINDOW_MS.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_PER_MINUTE=300
APP_ACCESS_SECRET=
ACCESS_SESSION_SECONDS=86400
# Use true em HTTPS. Para origens de sites diferentes, use COOKIE_SAME_SITE=none.
SECURE_COOKIES=false
COOKIE_SAME_SITE=lax
LOG_LEVEL=info
USE_MOCK_DATA=false
